# Public browser configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Google OAuth web client. Callback: http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=
# 32-byte base64 key used to encrypt provider tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Supabase project settings. The service role value is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional structured log label
LOG_LEVEL=info

# UI-only preview mode. Never enable this in production.
mock_data=false
