# Public browser configuration. VaultSync Production uses
# https://vaultsync-mu.vercel.app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Google OAuth Web client. Authorized production values:
# JavaScript origin: https://vaultsync-mu.vercel.app
# Redirect URI: https://vaultsync-mu.vercel.app/api/auth/google/callback
# Local redirect URI: http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=
# 32-byte base64 key used to encrypt provider tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Supabase project settings. The service role value is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional structured log label
LOG_LEVEL=info

# UI-only preview mode. Keep false or omit in Vercel Production.
MOCK_DATA=false
